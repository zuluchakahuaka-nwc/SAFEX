# Application Configuration
APP_NAME=SAFEX
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://safex:safex_password@localhost:5432/safex_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=True  # Set to False for async tasks
CELERY_WORKER_CONCURRENCY=1

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@safex.io
EMAIL_USE_TLS=True

# Validation Configuration
VALIDATION_COOLING_PERIOD_DAYS=30
VALIDATION_TOKEN_EXPIRE_HOURS=24

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Scan Configuration
MAX_CONCURRENT_SCANS=1
SCAN_TIMEOUT_MINUTES=60
BACKUP_RETENTION_DAYS=30

# Report Configuration
REPORTS_DIR=./reports
BACKUPS_DIR=./data/backups
TEMP_DIR=./data/temp

# Security Tools Configuration
NMAP_PATH=/usr/bin/nmap
NIKTO_PATH=/usr/bin/nikto
ZAP_PATH=/usr/bin/zap
OPENVAS_PATH=/usr/bin/openvas

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/safex.log

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=3600  # 1 hour

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_COMPRESSION=gzip
